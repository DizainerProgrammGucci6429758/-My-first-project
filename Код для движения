using UnityEngine;

public class PlayerController : MonoBehaviour
{
    [Header("Настройки движения и инерции")]
    [Tooltip("Максимальная скорость бега")]
    public float moveSpeed = 7f;
   
    [Tooltip("Как быстро персонаж разгоняется")]
    public float acceleration = 60f;
   
    [Tooltip("Как быстро персонаж останавливается (торможение)")]
    public float deceleration = 80f;

    [Header("Настройки прыжка и Coyote Time")]
    [Tooltip("Сила прыжка")]
    public float jumpForce = 14f;
   
    [Tooltip("Время койота (в секундах). Позволяет прыгнуть чуть позже, чем персонаж сошел с края")]
    public float coyoteTime = 0.15f;
    private float coyoteTimeCounter;

    [Header("Проверка земли (Ground Check)")]
    public Transform groundCheck;
    public float groundCheckRadius = 0.2f;
    public LayerMask groundLayer;

    [Header("Анимации")]
    [Tooltip("Ссылка на компонент Animator (заполнится автоматически, если есть)")]
    private Animator animator;

    private Rigidbody2D rb;
    private float moveInput;
    private bool isGrounded;

    void Start()
    {
        rb = GetComponent<Rigidbody2D>();
        animator = GetComponent<Animator>();
    }

    void Update()
    {
        // 1. Считываем ввод
        moveInput = Input.GetAxisRaw("Horizontal");

        // 2. Проверяем землю
        isGrounded = Physics2D.OverlapCircle(groundCheck.position, groundCheckRadius, groundLayer);

        // 3. Логика Coyote Time (Время койота)
        if (isGrounded)
        {
            // Если мы на земле, сбрасываем таймер койота на максимум
            coyoteTimeCounter = coyoteTime;
        }
        else
        {
            // Если в воздухе, таймер постепенно истекает
            coyoteTimeCounter -= Time.deltaTime;
        }

        // 4. Обработка прыжка
        // Прыгаем, если нажат Jump И таймер койота еще не истек (> 0)
        if (Input.GetButtonDown("Jump") && coyoteTimeCounter > 0f)
        {
            rb.velocity = new Vector2(rb.velocity.x, jumpForce);
           
            // Важно: обнуляем таймер сразу после прыжка,
            // чтобы нельзя было сделать двойной прыжок с помощью Coyote Time
            coyoteTimeCounter = 0f;
        }

        // 5. Обновление анимаций
        UpdateAnimations();
    }

    void FixedUpdate()
    {
        // 6. Плавное движение с инерцией (Ускорение и Торможение)
        float targetSpeed = moveInput * moveSpeed;
       
        // Выбираем скорость изменения: если нет ввода, используем торможение, если есть - ускорение
        float rate = (moveInput == 0) ? deceleration : acceleration;

        // Mathf.MoveTowards плавно изменяет текущую скорость к целевой
        float newSpeed = Mathf.MoveTowards(rb.velocity.x, targetSpeed, rate * Time.fixedDeltaTime);

        // Применяем новую скорость, сохраняя вертикальную (гравитацию)
        rb.velocity = new Vector2(newSpeed, rb.velocity.y);
    }

    private void UpdateAnimations()
    {
        if (animator != null)
        {
            // Передаем параметры в Animator
            // Speed: 0 когда стоим, 1 (или -1) когда бежим. Используем Abs для удобства в Blend Tree
            animator.SetFloat("Speed", Mathf.Abs(moveInput));
           
            // IsGrounded: true на земле, false в прыжке/падении
            animator.SetBool("IsGrounded", isGrounded);
           
            // Опционально: можно передать вертикальную скорость для разделения анимаций прыжка и падения
            // animator.SetFloat("VelocityY", rb.velocity.y);
        }
    }

    // Визуализация зоны проверки в редакторе
    void OnDrawGizmosSelected()
    {
        if (groundCheck != null)
        {
            Gizmos.color = Color.red;
            Gizmos.DrawWireSphere(groundCheck.position, groundCheckRadius);
        }
    }
}
